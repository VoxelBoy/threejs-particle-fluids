{
  "name": "threejs-particle-fluids",
  "version": "0.1.0",
  "private": true,
  "description": "Nine interactive particle experiments built with Three.js and WebGPU.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "assets:elastic": "node --import tsx scripts/prepare-elastic-assets.ts",
    "assets:honey": "node --import tsx scripts/prepare-honey-assets.ts",
    "lint": "eslint",
    "test": "vitest run",
    "test:gpu": "node scripts/run-tests.mjs gpu",
    "test:perf": "node --import tsx tests/perf/_helpers/run.ts",
    "bench:baseline": "node --import tsx tests/perf/_helpers/run.ts --baseline",
    "test:demo": "playwright test"
  },
  "dependencies": {
    "three": "0.184.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.4",
    "@types/three": "0.184.0",
    "@vitest/browser-playwright": "4.1.11",
    "@webgpu/types": "0.1.74",
    "eslint": "9.39.5",
    "playwright": "1.63.0",
    "prettier": "3.3.3",
    "tsx": "4.23.15",
    "typescript": "5.6.3",
    "typescript-eslint": "8.70.1",
    "vite": "6.4.3",
    "vitest": "4.1.11"
  }
}
