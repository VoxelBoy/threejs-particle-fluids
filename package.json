{
  "name": "threejs-particle-fluids",
  "version": "0.1.0",
  "description": "GPU particle physics for Three.js: liquids, soft bodies, cloth, and smoke, simulated and rendered with WebGPU.",
  "keywords": [
    "three",
    "threejs",
    "webgpu",
    "tsl",
    "physics",
    "fluid",
    "sph",
    "pbd",
    "xpbd",
    "soft-body",
    "cloth",
    "smoke",
    "particles",
    "simulation"
  ],
  "homepage": "https://github.com/dgreenheck/threejs-particle-fluids#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dgreenheck/threejs-particle-fluids.git"
  },
  "bugs": {
    "url": "https://github.com/dgreenheck/threejs-particle-fluids/issues"
  },
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run build:lib && npm run build:demo",
    "build:lib": "rm -rf dist && tsc -p tsconfig.build.json",
    "build:demo": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:gpu": "node scripts/run-tests.mjs gpu",
    "test:demo": "playwright test",
    "test:perf": "node --import tsx tests/perf/_helpers/run.ts",
    "bench:baseline": "node --import tsx tests/perf/_helpers/run.ts --baseline",
    "assets:elastic": "node --import tsx scripts/prepare-elastic-assets.ts",
    "assets:honey": "node --import tsx scripts/prepare-honey-assets.ts",
    "prepublishOnly": "npm run build:lib",
    "perf:profile": "node --import tsx tests/perf/_helpers/profile.ts",
    "perf:fingerprint": "node --import tsx tests/perf/_helpers/fingerprint.ts",
    "perf:ab": "node --import tsx tests/perf/_helpers/ab.ts"
  },
  "peerDependencies": {
    "@types/three": ">=0.184.0 <0.185.0",
    "three": ">=0.184.0 <0.185.0"
  },
  "peerDependenciesMeta": {
    "@types/three": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.4",
    "@types/three": "0.184.0",
    "@vitest/browser-playwright": "4.1.11",
    "@webgpu/types": "0.1.74",
    "eslint": "9.39.5",
    "playwright": "1.63.0",
    "prettier": "3.3.3",
    "three": "0.184.0",
    "tsx": "4.23.15",
    "typescript": "5.6.3",
    "typescript-eslint": "8.70.1",
    "vite": "6.4.3",
    "vitest": "4.1.11"
  }
}
